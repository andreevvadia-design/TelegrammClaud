import base64
import hashlib
import os
from typing import Any, List

from android.os import Build
from android.util import Base64
from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment
from dalvik.system import DexClassLoader, InMemoryDexClassLoader
from hook_utils import find_class
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader, LiteMode
from org.telegram.messenger.browser import Browser
from org.telegram.ui import LaunchActivity
from ui.bulletin import BulletinHelper
from ui.settings import Header, Switch, Text

__id__ = "liquid_bottom_tabs"
__name__ = "iExtera"
__description__ = "Редизайн Exteragram в стиле iOS версии Telegram, гибкая настройка всех элементов и эффект Жидкого стекла."
__author__ = "@Flux_Plugins"
__version__ = "1.0"
__icon__ = "apple_icon/1"
__min_version__ = "12.5.1"

DEX_SHA256 = "498b94d215efe55781bef205e4cafc7b7efda04ecbe72baa3b938e36340b92b5"
DEX_BASE64 = ""


class MainTabsCreateHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        run_on_ui_thread(lambda: self.plugin.install_on_activity(param.thisObject))


class MainTabsLayoutHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin.install_on_layout(param.thisObject)


class MainTabsMeasureHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.bridge is not None:
            self.plugin.bridge.equalizeView(param.thisObject)


class ChatHeaderHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        run_on_ui_thread(lambda: self.plugin.install_chat_header(param.thisObject))


class InterfaceRecoveryHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        run_on_ui_thread(self.plugin.repair_current)


class LiquidBottomTabsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.runtime_unhooks = []
        self.dex_loader = None
        self.bridge = None
        self.watchdog_active = False
        self.restart_notice_attempts = 0

    def on_plugin_load(self):
        try:
            self.load_bridge()
            self.sync_liquid_glass()
            self.apply_configuration()
        except Exception as error:
            self.log("Liquid Bottom Tabs load failed: " + str(error))
            return
        self.register_hook("org.telegram.ui.MainTabsActivity", "createView", MainTabsCreateHook(self))
        self.register_hook("org.telegram.ui.MainTabsActivity", "onResume", MainTabsCreateHook(self))
        self.register_hook("org.telegram.ui.MainTabsLayout", "onLayout", MainTabsLayoutHook(self))
        self.register_hook("org.telegram.ui.MainTabsLayout", "onAttachedToWindow", MainTabsLayoutHook(self))
        self.register_hook("org.telegram.ui.MainTabsLayout", "onMeasure", MainTabsMeasureHook(self))
        self.register_hook("org.telegram.ui.ChatActivity", "createView", ChatHeaderHook(self))
        self.register_hook("org.telegram.ui.ChatActivity", "onResume", ChatHeaderHook(self))
        self.register_hook("org.telegram.ui.ActionBar.BaseFragment", "onResume", InterfaceRecoveryHook(self))
        self.register_hook("org.telegram.ui.ActionBar.BaseFragment", "onTransitionAnimationEnd", InterfaceRecoveryHook(self))
        self.register_hook(LaunchActivity, "onResume", InterfaceRecoveryHook(self))
        self.register_hook(LaunchActivity, "onWindowFocusChanged", InterfaceRecoveryHook(self))
        self.watchdog_active = True
        run_on_ui_thread(self.install_current)
        run_on_ui_thread(self.repair_current, 120)
        run_on_ui_thread(self.repair_current, 420)
        run_on_ui_thread(self.watchdog_tick, 1200)
        if not bool(self.get_setting("restart_notice_shown", False)):
            run_on_ui_thread(self.show_restart_notice, 900)

    def register_hook(self, target, method_name, callback):
        try:
            target_class = find_class(target) if isinstance(target, str) else target
            hooks = self.hook_all_methods(target_class, method_name, callback)
            if hooks:
                self.runtime_unhooks.extend(list(hooks))
        except Exception as error:
            self.log("iExtera hook failed for " + method_name + ": " + str(error))

    def on_plugin_unload(self):
        self.watchdog_active = False
        for unhook in list(self.runtime_unhooks):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.runtime_unhooks.clear()
        if self.bridge is not None:
            try:
                self.bridge.uninstallAll()
            except Exception:
                pass
        self.bridge = None
        self.dex_loader = None

    def load_bridge(self):
        dex_bytes = base64.b64decode(DEX_BASE64)
        digest = hashlib.sha256(dex_bytes).hexdigest()
        if digest != DEX_SHA256:
            raise RuntimeError("DEX checksum mismatch")
        context = ApplicationLoader.applicationContext
        parent = context.getClassLoader()
        if int(Build.VERSION.SDK_INT) >= 26:
            self.dex_loader = InMemoryDexClassLoader(ByteBuffer.wrap(dex_bytes), parent)
        else:
            dex_file = os.path.join(str(context.getCodeCacheDir().getAbsolutePath()), "flux_liquid_tabs.dex")
            with open(dex_file, "wb") as output:
                output.write(dex_bytes)
            os.chmod(dex_file, 0o444)
            self.dex_loader = DexClassLoader(dex_file, str(context.getCodeCacheDir().getAbsolutePath()), None, parent)
        bridge_class = self.dex_loader.loadClass("dev.flux.liquidtabs.LiquidTabsBridge")
        self.bridge = bridge_class.newInstance()

    def sync_liquid_glass(self):
        system_enabled = bool(LiteMode.isEnabledSetting(262144))
        if system_enabled:
            self.set_setting("liquid_glass", True, reload_settings=False)
        enabled = bool(self.get_setting("liquid_glass", system_enabled))
        if enabled != system_enabled:
            LiteMode.toggleFlag(262144, enabled)

    def apply_configuration(self):
        if self.bridge is None:
            return
        liquid = bool(self.get_setting("liquid_glass", bool(LiteMode.isEnabledSetting(262144))))
        if bool(LiteMode.isEnabledSetting(262144)) != liquid:
            LiteMode.toggleFlag(262144, liquid)
        self.bridge.configure(
            bool(self.get_setting("top_panel", True)),
            bool(self.get_setting("navigation", True)),
            bool(self.get_setting("chat_headers", True)),
            liquid,
        )

    def on_interface_setting_change(self, value):
        run_on_ui_thread(self.apply_and_refresh)
        run_on_ui_thread(self.apply_and_refresh, 120)

    def apply_and_refresh(self):
        self.apply_configuration()
        self.repair_current()

    def repair_current(self):
        if self.bridge is None:
            return
        try:
            self.bridge.repair()
        except Exception:
            pass
        self.install_current()

    def watchdog_tick(self):
        if not self.watchdog_active or self.bridge is None:
            return
        self.repair_current()
        if self.watchdog_active:
            run_on_ui_thread(self.watchdog_tick, 1200)

    def show_restart_notice(self):
        if self.bridge is None:
            return
        self.restart_notice_attempts += 1
        try:
            BulletinHelper.show_info("Перезапустите exteraGram!")
            self.set_setting("restart_notice_shown", True, reload_settings=False)
        except Exception:
            if self.restart_notice_attempts < 6:
                run_on_ui_thread(self.show_restart_notice, 900)

    def install_current(self):
        try:
            current = get_last_fragment()
            if current is not None:
                current_name = str(current.getClass().getName())
                if current_name == "org.telegram.ui.MainTabsActivity":
                    self.install_on_activity(current)
                elif current_name == "org.telegram.ui.ChatActivity":
                    self.install_chat_header(current)
            launch_activity = LaunchActivity.instance
            if launch_activity is None:
                return
            navigation = launch_activity.getActionBarLayout()
            if navigation is None:
                return
            stack = navigation.getFragmentStack()
            if stack is None:
                return
            for index in range(int(stack.size())):
                fragment = stack.get(index)
                if fragment is None:
                    continue
                name = str(fragment.getClass().getName())
                if name == "org.telegram.ui.MainTabsActivity":
                    self.install_on_activity(fragment)
                elif name == "org.telegram.ui.ChatActivity":
                    self.install_chat_header(fragment)
        except Exception as error:
            self.log("Liquid Bottom Tabs current screen install failed: " + str(error))

    def install_on_activity(self, activity):
        if self.bridge is None or activity is None:
            return
        try:
            if not bool(self.bridge.install(activity)):
                self.log("Liquid Bottom Tabs panel was not found")
        except Exception as error:
            self.log("Liquid Bottom Tabs install failed: " + str(error))

    def install_on_layout(self, layout):
        if self.bridge is None or layout is None:
            return
        try:
            self.bridge.installView(layout)
        except Exception as error:
            self.log("Liquid Bottom Tabs layout install failed: " + str(error))

    def install_chat_header(self, activity):
        if self.bridge is None or activity is None:
            return
        try:
            self.bridge.installChatHeader(activity)
        except Exception as error:
            self.log("Liquid Bottom Tabs chat header failed: " + str(error))

    def open_author_channel(self, view):
        fragment = get_last_fragment()
        context = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
        Browser.openUrl(context, "https://t.me/Flux_Plugins")

    def create_settings(self) -> List[Any]:
        liquid_default = bool(LiteMode.isEnabledSetting(262144))
        return [
            Header(text="Элементы интерфейса"),
            Switch(
                key="top_panel",
                text="Верхняя панель",
                default=True,
                subtext="Оформляет верхнюю панель главного экрана",
                icon="msg_customize",
                on_change=self.on_interface_setting_change,
            ),
            Switch(
                key="navigation",
                text="Навигация",
                default=True,
                subtext="Включает нижнюю стеклянную панель навигации",
                icon="msg_view_file",
                on_change=self.on_interface_setting_change,
            ),
            Switch(
                key="chat_headers",
                text="Шапки чатов",
                default=True,
                subtext="Добавляет стеклянные подложки кнопкам назад и меню",
                icon="msg_discussion",
                on_change=self.on_interface_setting_change,
            ),
            Header(text="Эффект стекла"),
            Switch(
                key="liquid_glass",
                text="LiquidGlass",
                default=liquid_default,
                subtext="Включает размытие и эффект LiquidGlass вместо стандартного Frosted Glass",
                icon="msg_blur_linear",
                on_change=self.on_interface_setting_change,
            ),
            Text(
                text="Автор — @Flux_Plugins",
                subtext="Открыть канал",
                icon="msg_channel",
                accent=True,
                on_click=self.open_author_channel,
            ),
        ]
